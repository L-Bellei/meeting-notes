# Wails build artifacts (binaries, generated files). appicon.png e
# windows/icon.ico são ASSETS-FONTE rastreados de propósito: quando ausentes,
# o `wails build` os regenera com o logo default do Wails — foi assim que as
# v2.6.0-v2.8.0 saíram com o "W" no exe e no instalador (ver DECISIONS 2026-08-29).
/cmd/desktop/build/bin/
/cmd/desktop/build/windows/tray.ico
/cmd/desktop/build/windows/wails_tools.nsh
/cmd/desktop/build/windows/info.json
/cmd/desktop/build/windows/installer/
/cmd/desktop/build/windows/wails.exe.manifest
/cmd/desktop/frontend/dist/
/dist/
desktop.exe

# Frontend generated
/frontend/package.json.md5
/frontend/src/wailsjs/wailsjs/

# Superpowers plugin artifacts
/.superpowers/

# Claude local settings
/.claude/settings.local.json

# PyInstaller build artifacts (but keep the spec that produces them - it is
# not reproducible from anything else committed to the repo). A bare
# trailing-slash pattern (`build/`) makes git prune the whole subtree and
# never look inside for the negations below, so `build/*` is used instead.
/audio-service/build/*
!/audio-service/build/pyinstaller/
/audio-service/build/pyinstaller/*
!/audio-service/build/pyinstaller/*.spec
/audio-service/dist/

# Binário do whisper.cpp (Vulkan) compilado por build/fetch-whispercpp.ps1 — não
# rastreado, como o bundle. O pin e o script que o reproduzem SÃO rastreados.
/audio-service/vendor/
!/audio-service/build/whispercpp.version
!/audio-service/build/fetch-whispercpp.ps1

# Stray files
/docs/estado-da-conversa-*.md
/migrations/

# QA residue from Playwright MCP browser-driven verification
/.playwright-mcp/
